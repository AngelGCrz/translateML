        "pages": [
            {
                "titles": [
                    {
                        "text": "GAME RULES"
                    }
                ],
                "items": {
                    "lines": [
                        "• Play up to 25 lines. ",
                        "• Highest win only on each lit line.",
                        "• Coinciding wins on different lit lines are added.",
                        "• Line wins are multiplied by the amount bet per line.",
                        "• Scattered symbol wins are multiplied by total bet.",
                        "• Scattered symbol wins are added to payline wins. ",
                        "• Payouts are made according to the paytable."
                    ]
                }
            },
            {
                "titles": [
                    {
                        "text": "GAME RULES"
                    }
                ],
                "items": {
                    "lines": [
                        "• All symbols pay when they appear consecutively left to right, from reel 1, except scattered", 
                        "   ##sym_13.png## which pays on any position. ","",
                        "• ##sym_1.png## substitutes for all symbols except scattered ##sym_13.png##.","",
                        "• When ##sym_1.png## substitutes into a winning combination,the prize is doubled."
                    ]
                }
            },
            {
                "titles": [
                    {
                        "text": "FREE GAMES FEATURE"
                    }
                ],
                "items": {
                    "lines": [
                        "• The Free Games Feature is triggered when scattered ##sym_13.png## appears ",
                        "   three or more times in a combination.",
                        "• 10, 15 or 20 free games are awarded if scattered ##sym_13.png## appears 3, 4 or 5 times respectively.",
                        "• During the Free Games Feature all prizes are tripled.",
                        "• The Free Games Feature can be retriggered when scattered ##sym_13.png##",
                        "   appears 2 times in a combination.",
                        "• During the Free Games Feature 5, 10, 15 or 20 additional freegames are awarded",
                        "   if scattered ##sym_13.png## appears 2, 3, 4 or 5 times respectively."
                    ]
                }
            },
            {
                "titles": [
                    {
                        "text": "MYSTIC CARDS FEATURE"
                    }
                ],
                "items": {
                    "lines": [
                        "• 6 or more symbols with ##sym_14.png## trigger the Mystic Cards Feature.",
                        "• All winning combinations on the triggering spin are paid.",
                        "• All ##sym_14.png## symbols are held and 3 respins are awarded.",
                        "• During the Mystic Cards Feature, any ##sym_14.png## appears and the respins remaining are reset",
                        "   to 3 respins.",
                        "• Each ##sym_14.png## awards a prize during the feature, and the prizes from the ##sym_14.png## that triggered",
                        "   it can only be collected at the end.",
                        "• The Mystic Cards Feature concludes when all 15 ##sym_14.png## appear or when all respins are",
                        "   finished."
                    ]
                }
            },
            {
                "titles": [
                    {
                        "text": "MYSTIC CARDS FEATURE"
                    }
                ],
                "items": {
                    "lines": [
                        "• If the ##sym_14.png## symbol appears in every position on the reels, it will award a additional prize",
                        "   of up to 1000 times the stake of the bet that triggered the feature.",
                        "• All prizes are multiplied by the triggering bet.",
                        "• The Mystic Cards Feature can be awarded during the Free Games Feature.",
                        "• If ##text_grand.png##  appears as the last symbol then you are awarded the Grand Jackpot.",
                        "• If ##text_major.png## appears as the last symbol, then you are awarded the Major Jackpot.",
                        "• If all ##sym_14.png## are collected and a Jackpot prize is awarded, the Jackpot prize cannot",
                        "   be multiplied."
                    ]
                }
            },
            {
                "titles": [
                    {
                        "text": "MYSTIC CARDS FEATURE"
                    }
                ],
                "items": {
                    "lines": [
                        "• If a Jackpot prize is awarded during the Mystic Cards Feature before all ##sym_14.png## are collected,",
                        "    the Mystic Cards Feature concludes."
                    ]
                }
            }
        ]
